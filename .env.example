# Application
BUDGET_API_PORT=3001
BUDGET_API_NODE_ENV=development

# Security & Registration
BUDGET_API_KEY=your_secure_api_key_for_all_requests
BUDGET_API_JWT_SECRET=super_secret_jwt_key_change_in_production
BUDGET_API_JWT_EXPIRES_IN=1h
BUDGET_API_JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_change_in_production
BUDGET_API_JWT_REFRESH_EXPIRES_IN=7d
BUDGET_API_ALLOW_REGISTRATION=false
BUDGET_API_REGISTRATION_INVITE_CODE=BUDGET_VIP_2026

# Database
BUDGET_API_MONGO_URI=mongodb://localhost:27017/budget_db

# Web Push (VAPID) - Generate with npx web-push generate-vapid-keys
BUDGET_API_VAPID_PUBLIC_KEY=
BUDGET_API_VAPID_PRIVATE_KEY=
BUDGET_API_VAPID_SUBJECT=mailto:admin@jonmb.com

# Email (SMTP / Resend)
BUDGET_API_EMAIL_PROVIDER=smtp
BUDGET_API_SMTP_HOST=smtp.example.com
BUDGET_API_SMTP_PORT=587
BUDGET_API_SMTP_USER=user@example.com
BUDGET_API_SMTP_PASS=password
BUDGET_API_SMTP_FROM=Budget App <budget@jonmb.com>
BUDGET_API_RESEND_API_KEY=
