# Application
PORT=3000
NODE_ENV=development

# Security & Registration
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d
REGISTRATION_INVITE_CODE=BUDGET_VIP_2026

# Database
MONGO_URI=mongodb://localhost:27017/budget_db

# Web Push (VAPID) - Generate with npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@jonmb.com

# Email (SMTP / Resend)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
SMTP_FROM=Budget App <budget@jonmb.com>
RESEND_API_KEY=
